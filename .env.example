# Port exposed on host (default 8085 to avoid clashing with 8080 on the RPi5)
SANTA_PORT=8085

# Password for the "Förbered & Seed" admin tab
SECRET_SANTA_ADMIN_PASSWORD=tomten

# Set to 1 while testing/verifying the draw; set to 0 (or click "Lås & Gå Live" in UI) for production
SECRET_SANTA_DEV_MODE=1
